{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python .claude/hooks/check_secrets.py",
            "if": "Bash(git commit *)",
            "timeout": 30,
            "statusMessage": "Scanning staged diff for secrets..."
          }
        ]
      }
    ]
  }
}
