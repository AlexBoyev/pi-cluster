[Unit]
Description=Pi-Cluster Docker Compose Stack
Documentation=https://github.com/AlexBoyev/pi-cluster
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/admin/pi-cluster
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=180
TimeoutStopSec=60
Restart=no

[Install]
WantedBy=multi-user.target
