APP_NAME=pi-cluster
ENVIRONMENT=development
LOG_LEVEL=INFO

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pi_cluster
POSTGRES_USER=pi_cluster
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_REAL_LOCAL_PASSWORD

DATABASE_URL=postgresql+asyncpg://pi_cluster:CHANGE_THIS_TO_A_REAL_LOCAL_PASSWORD@postgres:5432/pi_cluster

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

SSH_USERNAME=admin
SSH_PASSWORD=admin
SSH_CONNECT_TIMEOUT=10
SSH_COMMAND_TIMEOUT=15

JWT_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

PROMETHEUS_URL=http://prometheus:9090

GRAFANA_URL=http://grafana:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_TO_A_REAL_LOCAL_PASSWORD

ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123
