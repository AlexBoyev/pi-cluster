# Pi-Cluster environment configuration
# Copy this file to .env and fill in real values.

# Application

APP_NAME=pi-cluster
ENVIRONMENT=production
LOG_LEVEL=INFO

# Backend

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# PostgreSQL

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pi_cluster
POSTGRES_USER=pi_cluster
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql+asyncpg://pi_cluster:CHANGE_ME@postgres:5432/pi_cluster

# Redis

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# SSH (credentials used to connect to Pi nodes)

SSH_USERNAME=admin
SSH_PASSWORD=CHANGE_ME
SSH_CONNECT_TIMEOUT=10
SSH_COMMAND_TIMEOUT=15

# Authentication

JWT_SECRET_KEY=CHANGE_ME
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Wallabag auto-login bridge (see docs/decisions.md) - the one shared
# Wallabag account's real credentials, used server-side only to skip its
# login screen for anyone with a valid pi-cluster session. Never sent to
# the frontend.
WALLABAG_USERNAME=wallabag
WALLABAG_PASSWORD=CHANGE_ME

# Vikunja auto-login bridge (see docs/decisions.md) - unlike Wallabag's one
# shared account, Vikunja has two real distinct accounts, so this maps
# pi-cluster username -> that same person's own Vikunja password. JSON
# object; a pi-cluster user with no entry here just doesn't get the
# bridge (falls through to Vikunja's own login). Never sent to the
# frontend.
VIKUNJA_BRIDGE_CREDENTIALS={"admin":"CHANGE_ME"}

# Brevo SMTP relay (see docs/decisions.md, Vikunja ADR D2) - shared between
# Vikunja's own reminder mail (k8s/apps/vikunja Secret, not this file) and
# the platform's security-alert notifications (new-IP logins etc., not yet
# built). A relay, not a mailbox - destination address is configured in
# the admin UI once that alert system exists, not hardcoded here.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=CHANGE_ME
BREVO_SMTP_PASSWORD=CHANGE_ME
BREVO_ALERT_FROM_EMAIL=alerts@cluster.download

# Prometheus

PROMETHEUS_URL=http://prometheus:9090

# Grafana

GRAFANA_URL=http://grafana:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Jenkins (shown in Key Vault — set to your Jenkins admin password)

JENKINS_ADMIN_PASSWORD=CHANGE_ME

# ArgoCD (shown in Key Vault — must match ArgoCD's actual admin password.
# ArgoCD stores this itself in the argocd-secret K8s Secret; this value is
# just what the vault displays, so keep the two in sync by hand whenever
# the ArgoCD password is changed — see docs/decisions.md.)

ARGOCD_ADMIN_PASSWORD=CHANGE_ME

# App admin account (seeded on first run)

ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=CHANGE_ME

# Cloudflare Tunnel (get token from one.dash.cloudflare.com → Networks → Tunnels)

CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# GitHub fine-grained PAT, scoped to just this repo with Contents: write
# only. Lets the alert-rules UI (Settings -> Alert Rules) commit and push
# prometheus/alerts.yml directly, so a rule added/edited/deleted through
# the UI doesn't get silently reverted by the next unrelated git push -
# admin@pi-node1 has no git push credentials of its own otherwise. Used
# for that one file only. See docs/decisions.md.

GITHUB_PAT=CHANGE_ME

# Log & audit retention (days to keep audit_logs and resolved alert_history
# rows before the background cleanup job deletes them; active/unresolved
# alerts are never deleted regardless of age). Does not affect Loki, which
# has its own independent retention_period in loki/loki-config.yml.

LOG_RETENTION_DAYS=90

# Reserved for a future household-service enrichment companion (article
# summarisation, etc. — polls Wallabag's REST API, never built into
# Wallabag itself). NOT used by anything yet as of this writing. Separate
# billing from a claude.ai subscription — these are API keys, not account
# credentials.

ANTHROPIC_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
