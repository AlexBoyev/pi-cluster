# Pi-Cluster environment configuration
# Copy this file to .env and fill in real values.

# Application

APP_NAME=pi-cluster
ENVIRONMENT=production
LOG_LEVEL=INFO

# Backend

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# PostgreSQL

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pi_cluster
POSTGRES_USER=pi_cluster
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql+asyncpg://pi_cluster:CHANGE_ME@postgres:5432/pi_cluster

# Redis

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# SSH (credentials used to connect to Pi nodes)

SSH_USERNAME=admin
SSH_PASSWORD=CHANGE_ME
SSH_CONNECT_TIMEOUT=10
SSH_COMMAND_TIMEOUT=15

# Authentication

JWT_SECRET_KEY=CHANGE_ME
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Prometheus

PROMETHEUS_URL=http://prometheus:9090

# Grafana

GRAFANA_URL=http://grafana:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Jenkins (shown in Key Vault — set to your Jenkins admin password)

JENKINS_ADMIN_PASSWORD=CHANGE_ME

# App admin account (seeded on first run)

ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=CHANGE_ME

# Cloudflare Tunnel (get token from one.dash.cloudflare.com → Networks → Tunnels)

CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME
